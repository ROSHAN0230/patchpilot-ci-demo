# Copy this file to .env in the same directory and fill in your keys:
# NEBIUS_API_KEY is required for Token Factory inference and ConTree Sandboxes.
NEBIUS_API_KEY=your_nebius_api_key_here

# NEBIUS_PROJECT_ID is required for ConTree Sandbox access in Beta.
# (Found in the Nebius Token Factory / Cloud Console under Projects)
NEBIUS_PROJECT_ID=your_nebius_project_id_here

# TAVILY_API_KEY is required for live documentation search ($3,000 bonus track).
TAVILY_API_KEY=your_tavily_api_key_here
